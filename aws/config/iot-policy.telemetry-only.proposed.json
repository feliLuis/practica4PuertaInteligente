{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:us-east-2:<ACCOUNT_ID>:client/chapa-inteligente-01"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": [
        "arn:aws:iot:us-east-2:<ACCOUNT_ID>:topic/chapa/chapa-inteligente-01/events",
        "arn:aws:iot:us-east-2:<ACCOUNT_ID>:topic/$aws/things/chapa-inteligente-01/shadow/update"
      ]
    }
  ]
}
